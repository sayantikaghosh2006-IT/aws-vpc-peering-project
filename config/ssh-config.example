# EWB VPC Peering - SSH configuration TEMPLATE
# Copy these entries into ~/.ssh/config on your laptop (WSL, macOS or Linux).
# Replace BASTION_PUBLIC_IP with the bastion's current public IPv4.
# The private key lives only at ~/.ssh/ewb-lab-key-us.pem (chmod 400). Never commit it
# and never copy it to an EC2 instance.

Host ewb-bastion
    HostName BASTION_PUBLIC_IP
    User ec2-user
    IdentityFile ~/.ssh/ewb-lab-key-us.pem
    IdentitiesOnly yes

Host ewb-app-a
    HostName 10.10.2.72
    User ec2-user
    IdentityFile ~/.ssh/ewb-lab-key-us.pem
    IdentitiesOnly yes
    ProxyJump ewb-bastion

Host ewb-app-b
    HostName 10.20.1.75
    User ec2-user
    IdentityFile ~/.ssh/ewb-lab-key-us.pem
    IdentitiesOnly yes
    ProxyJump ewb-bastion